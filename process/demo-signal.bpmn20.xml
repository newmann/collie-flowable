<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:flowable="http://flowable.org/bpmn"
        xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
        xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
        xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
        targetNamespace="http://moqui.org/flowable"
        id="demoSignalDefinitions">
    <signal id="wfDemoGoSignal" name="wfDemoGo"/>
    <process id="demoSignal" name="Demo Signal Wait" isExecutable="true">
        <startEvent id="start" name="Start"/>
        <sequenceFlow id="toWait" sourceRef="start" targetRef="waitGo"/>
        <intermediateCatchEvent id="waitGo" name="Wait go">
            <signalEventDefinition signalRef="wfDemoGoSignal"/>
        </intermediateCatchEvent>
        <sequenceFlow id="toEnd" sourceRef="waitGo" targetRef="end"/>
        <endEvent id="end" name="End"/>
    </process>
    <bpmndi:BPMNDiagram id="BPMNDiagram_demoSignal">
        <bpmndi:BPMNPlane id="BPMNPlane_demoSignal" bpmnElement="demoSignal">
            <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="152" y="162" width="36" height="36"/></bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="waitGo_di" bpmnElement="waitGo"><dc:Bounds x="280" y="154" width="36" height="36"/></bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="420" y="162" width="36" height="36"/></bpmndi:BPMNShape>
            <bpmndi:BPMNEdge id="toWait_di" bpmnElement="toWait"><di:waypoint x="188" y="180"/><di:waypoint x="280" y="172"/></bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="toEnd_di" bpmnElement="toEnd"><di:waypoint x="316" y="172"/><di:waypoint x="420" y="180"/></bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
