<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Monitor" require-authentication="true">

    <subscreens>
        <subscreens-item name="MonitorDiagram" menu-include="false"
                location="component://collie-flowable/screen/MonitorDiagram.xml"/>
    </subscreens>

    <transition-include name="searchUserList" location="component://collie-flowable/screen/TaskList/Todo.xml"/>

    <actions>
        <service-call name="wf.flowable.WorkflowServices.list#ProcessInstances"
                in-map="[processInstanceId:processInstanceId]" out-map="context"/>
        <script>wf.flowable.WorkflowSupport.filterSortPaginate(ec, "instanceList",
                ["processInstanceId", "processDefinitionKey", "processDefinitionVersion",
                 "businessKey", "startUserId", "status", "currentActivities"])</script>
    </actions>
    <widgets>
        <label text="Process Monitor" type="h4"/>
        <form-list name="InstanceList" list="instanceList" skip-form="true" header-dialog="true" select-columns="true"
                   saved-finds="true" show-csv-button="true" show-page-size="true">
            <field name="processInstanceId">
                <header-field title="Instance" show-order-by="true">
                    <text-find size="20"/>
                </header-field>
                <default-field title="Instance">
                    <dynamic-dialog id="MonitorInst${processInstanceId}"
                            button-text="${processInstanceId}" title="Process Monitor"
                            transition="MonitorDiagram" width="1100" link-type="anchor">
                        <parameter name="processInstanceId"/>
                        <parameter name="processDefinitionKey"/>
                    </dynamic-dialog>
                </default-field>
            </field>
            <field name="processDefinitionKey">
                <header-field title="Process Number" show-order-by="case-insensitive">
                    <text-find size="20"/>
                </header-field>
                <default-field title="Process Number">
                    <dynamic-dialog id="MonitorKey${processInstanceId}"
                            button-text="${processDefinitionKey}" title="Process Monitor"
                            transition="MonitorDiagram" width="1100" link-type="anchor">
                        <parameter name="processInstanceId"/>
                        <parameter name="processDefinitionKey"/>
                    </dynamic-dialog>
                </default-field>
            </field>
            <field name="processDefinitionVersion">
                <header-field title="Version" show-order-by="true">
                    <text-find size="8"/>
                </header-field>
                <default-field title="Version"><display/></default-field>
            </field>
            <field name="businessKey">
                <header-field title="Business Key" show-order-by="case-insensitive">
                    <text-find size="20"/>
                </header-field>
                <default-field title="Business Key"><display/></default-field>
            </field>
            <field name="startUserId">
                <!-- <header-field title="Starter" show-order-by="case-insensitive">
                    <text-find size="20"/>
                </header-field> -->
                <header-field title="Starter" show-order-by="case-insensitive">
                    <drop-down allow-empty="true">
                        <dynamic-options transition="searchUserList" server-search="true" min-length="2"/>
                    </drop-down>
                </header-field>

                <default-field title="Starter">
                    <display-entity entity-name="mantle.party.PartyDetail" text="PartyNameTemplate"/>
                </default-field>

            </field>
            <field name="status">
                <header-field title="Status" show-order-by="true">
                    <drop-down allow-empty="true">
                        <option key="running" text="running"/>
                        <option key="ended" text="ended"/>
                    </drop-down>
                </header-field>
                <default-field title="Status">
                    <display style="${status == 'running' ? 'text-info' : 'text-muted text-grey'}"/>
                </default-field>
            </field>
            <field name="currentActivities">
                <header-field title="Current" show-order-by="true">
                    <text-find size="20"/>
                </header-field>
                <default-field title="Current"><display/></default-field>
            </field>
        </form-list>
    </widgets>
</screen>
