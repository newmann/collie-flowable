<template>
    <div class="q-pa-md">
        <div class="text-h5">Process Designer</div>
        <p>Canvas is bpmn-js. Keep the bpmn.io watermark visible. Use Save / Deploy on this screen.</p>
        <div id="wf-bpmn-canvas-qvue" style="height:640px;border:1px solid #ccc;position:relative;"></div>
    </div>
</template>
<script>
module.exports = {
    name: 'ProcessDesigner',
    mounted: function () {
        var self = this;
        function start() {
            if (typeof wfInitDesigner !== 'function') { setTimeout(start, 80); return; }
            wfInitDesigner({
                canvasId: 'wf-bpmn-canvas-qvue',
                existingXml: (self.bpmnXml || ''),
                moddleUrl: '/apps/collie-flowable/Asset?file=flowable.json',
                lookupBase: (window.location.pathname || '').replace(/\/$/, ''),
                lockKey: !!self.processDefinitionKey
            });
        }
        if (window.moqui && moqui.loadScript) {
            moqui.loadStylesheet('/apps/collie-flowable/Asset?file=diagram-js.css');
            moqui.loadStylesheet('/apps/collie-flowable/Asset?file=bpmn-js.css');
            moqui.loadStylesheet('/apps/collie-flowable/Asset?file=bpmn.css');
            moqui.loadScript('/apps/collie-flowable/Asset?file=bpmn-modeler.production.min.js', function () {
                moqui.loadScript('/apps/collie-flowable/Asset?file=designer.js', start);
            });
        } else {
            start();
        }
    },
    computed: {
        processDefinitionKey: function () { return this.$root && this.$root.currentParameters && this.$root.currentParameters.processDefinitionKey; },
        bpmnXml: function () { return this.$root && this.$root.currentParameters && this.$root.currentParameters.bpmnXml; }
    }
};
</script>
