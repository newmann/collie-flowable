<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Tasks" require-authentication="true">

    <parameter name="taskId"/>

    <transition name="claim">
        <service-call name="wf.flowable.WorkflowServices.claim#Task"/>
        <default-response url="."/>
    </transition>
    <transition name="unclaim">
        <service-call name="wf.flowable.WorkflowServices.unclaim#Task"/>
        <default-response url="."/>
    </transition>
    <transition name="complete">
        <service-call name="wf.flowable.WorkflowServices.complete#Task"/>
        <default-response url="."/>
    </transition>
    <transition name="transfer">
        <service-call name="wf.flowable.WorkflowServices.transfer#Task"/>
        <default-response url="."/>
    </transition>

    <actions>
        <service-call name="wf.flowable.WorkflowServices.list#MyTasks" out-map="context"/>
        <service-call name="wf.flowable.WorkflowServices.list#CompletedTasks" out-map="completedOut"/>
        <set field="completedTaskList" from="completedOut.taskList"/>
        <service-call name="wf.flowable.WorkflowServices.list#MyStarted" out-map="startedOut"/>
        <set field="startedList" from="startedOut.instanceList"/>
    </actions>
    <widgets>
        <label text="To Do" type="h4"/>
        <form-list name="TodoList" list="taskList" skip-form="true">
            <field name="name"><default-field title="Task">
                <link url="../InstanceDetail" text="${name}" link-type="anchor">
                    <parameter name="taskId"/>
                    <parameter name="processInstanceId"/>
                    <parameter name="businessKey"/>
                </link>
            </default-field></field>
            <field name="assignee"><default-field title="Assignee"><display/></default-field></field>
            <field name="businessKey"><default-field title="Business Key"><display/></default-field></field>
            <field name="formKey"><default-field title="Form"><display/></default-field></field>
            <field name="claim">
                <conditional-field title="" condition="!assignee">
                    <link url="claim" text="Claim"><parameter name="taskId"/></link>
                </conditional-field>
                <default-field title=""><display text=""/></default-field>
            </field>
            <field name="unclaim">
                <conditional-field title="" condition="assignee">
                    <link url="unclaim" text="Unclaim"><parameter name="taskId"/></link>
                </conditional-field>
                <default-field title=""><display text=""/></default-field>
            </field>
        </form-list>

        <container-dialog id="CompleteDialog" button-text="Complete selected task">
            <form-single name="CompleteTask" transition="complete">
                <field name="taskId"><default-field title="Task Id"><text-line size="24"/></default-field></field>
                <field name="outcome"><default-field title="Outcome">
                    <drop-down>
                        <option key="approve" text="Approve"/>
                        <option key="reject" text="Reject"/>
                        <option key="return" text="Return"/>
                    </drop-down>
                </default-field></field>
                <field name="comment"><default-field title="Comment"><text-area rows="3"/></default-field></field>
                <field name="submit"><default-field title="Complete"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <container-dialog id="TransferDialog" button-text="Transfer task">
            <form-single name="TransferTask" transition="transfer">
                <field name="taskId"><default-field title="Task Id"><text-line size="24"/></default-field></field>
                <field name="toUserId"><default-field title="To userId"><text-line size="20"/></default-field></field>
                <field name="comment"><default-field title="Comment"><text-area rows="2"/></default-field></field>
                <field name="submit"><default-field title="Transfer"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <label text="Completed" type="h4"/>
        <form-list name="DoneList" list="completedTaskList" skip-form="true">
            <field name="name"><default-field title="Task"><display/></default-field></field>
            <field name="processInstanceId"><default-field title="Instance">
                <link url="../InstanceDetail" text="${processInstanceId}" link-type="anchor">
                    <parameter name="processInstanceId"/>
                    <parameter name="businessKey"/>
                </link>
            </default-field></field>
            <field name="endTime"><default-field title="Ended"><display/></default-field></field>
        </form-list>

        <label text="Started by me" type="h4"/>
        <form-list name="StartedList" list="startedList" skip-form="true">
            <field name="processDefinitionKey"><default-field title="Key"><display/></default-field></field>
            <field name="businessKey"><default-field title="Business Key">
                <link url="../InstanceDetail" text="${businessKey}" link-type="anchor">
                    <parameter name="processInstanceId"/>
                    <parameter name="businessKey"/>
                </link>
            </default-field></field>
            <field name="status"><default-field title="Status"><display/></default-field></field>
            <field name="startTime"><default-field title="Started"><display/></default-field></field>
        </form-list>
    </widgets>
</screen>
