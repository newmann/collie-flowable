<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="My Tasks" require-authentication="true">

    <parameter name="taskId"/>

    <subscreens default-item="Todo">
        <subscreens-item name="Todo" menu-title="To Do" menu-index="1"
                location="component://collie-flowable/screen/TaskList/Todo.xml"/>
        <subscreens-item name="Completed" menu-title="Completed" menu-index="2"
                location="component://collie-flowable/screen/TaskList/Completed.xml"/>
        <subscreens-item name="Started" menu-title="Started by me" menu-index="3"
                location="component://collie-flowable/screen/TaskList/Started.xml"/>
    </subscreens>

    <widgets>
        <label text="My Tasks" type="h3"/>
        <subscreens-panel id="cf-task-lists" type="tab"/>
    </widgets>
</screen>
