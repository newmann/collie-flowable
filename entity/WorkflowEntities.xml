<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="WfProcessDefinition" package="wf.flowable" short-alias="wf-process-definitions">
        <field name="processDefinitionKey" type="id" is-pk="true"/>
        <field name="processName" type="text-medium"/>
        <field name="bpmnXml" type="text-very-long"/>
        <field name="statusId" type="id"/>
        <field name="deploymentId" type="text-medium"/>
        <relationship type="one" title="Status" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/>
        </relationship>
    </entity>

    <entity entity-name="WfProcessLink" package="wf.flowable" short-alias="wf-process-links">
        <field name="linkId" type="id" is-pk="true"/>
        <field name="entityName" type="text-medium"/>
        <field name="pkValue" type="text-medium"/>
        <field name="processInstanceId" type="text-medium"/>
        <field name="processDefinitionKey" type="id"/>
        <field name="statusId" type="id"/>
        <relationship type="one" title="Status" related="moqui.basic.StatusItem">
            <key-map field-name="statusId"/>
        </relationship>
        <index name="WF_LINK_LOOKUP" unique="false">
            <index-field name="entityName"/>
            <index-field name="pkValue"/>
            <index-field name="processDefinitionKey"/>
        </index>
        <index name="WF_LINK_ACTIVE" unique="false">
            <index-field name="pkValue"/>
            <index-field name="processDefinitionKey"/>
            <index-field name="statusId"/>
        </index>
    </entity>

    <entity entity-name="WfTaskComment" package="wf.flowable" short-alias="wf-task-comments">
        <field name="taskCommentId" type="id" is-pk="true"/>
        <field name="taskId" type="text-medium"/>
        <field name="processInstanceId" type="text-medium"/>
        <field name="nodeId" type="text-medium"/>
        <field name="userId" type="id"/>
        <field name="outcome" type="text-short"/>
        <field name="comment" type="text-long"/>
        <field name="commentDate" type="date-time"/>
        <field name="businessKey" type="text-medium"/>
        <relationship type="one" related="moqui.security.UserAccount">
            <key-map field-name="userId"/>
        </relationship>
        <index name="WF_COMMENT_INST">
            <index-field name="processInstanceId"/>
        </index>
        <index name="WF_COMMENT_BK">
            <index-field name="businessKey"/>
        </index>
    </entity>
</entities>
